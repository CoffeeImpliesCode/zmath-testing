export DIRENV_WARN_TIMEOUT=20s

# Nix is not installed natively on this host: ~/.local/bin/nix and
# ~/.local/bin/devenv run it inside an apptainer sandbox. direnv evaluates this
# file with the ambient PATH, so the user toolchain has to be on it before
# `use devenv` can start.
export PATH="$HOME/.local/bin:$PATH"

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv

# Rewrite COMPILE-TIME search paths only. Three things are deliberately left
# alone:
#   PATH, ZMATH_COMPARE_CC, ZMATH_COMPARE_CXX -- the store files are visible at
#     the sandbox path, but their ELF interpreters are named under /nix/store,
#     so a store binary cannot execute from the host at all.
#   LD_LIBRARY_PATH -- putting the sandbox store on the runtime search path
#     places a libmpfr built against a newer glibc in front of every process in
#     the devshell; the gate's own awk then dies with GLIBC_ABI_GNU2_TLS not
#     found and zlint reports no issue count at all. Tools that genuinely link
#     libmpfr are given the path they need by the build graph instead.
nix_store=/tmp/devenv-sbox/nix/store
for _name in LIBRARY_PATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH \
    ZMATH_COMPARE_GBENCHMARK_INCLUDE_DIR ZMATH_COMPARE_GBENCHMARK_LIBRARY_DIR \
    ZMATH_COMPARE_MPFR_INCLUDE_DIR ZMATH_COMPARE_MPFR_LIBRARY_DIR \
    ZMATH_COMPARE_GMP_INCLUDE_DIR ZMATH_COMPARE_GMP_LIBRARY_DIR \
    ZMATH_CORE_MATH_SOURCE_DIR ZMATH_GLIBC_SOURCE_DIR ZMATH_COMPARE_COREMATH_PATH
do
    _value=${!_name-}
    case $_value in
        *"/nix/store"*)
            printf -v "$_name" '%s' "${_value//\/nix\/store/$nix_store}"
            ;;
    esac
    export "$_name"
done
unset _name _value nix_store

# flint is the one oracle dependency the host cannot use from the store. The
# sandbox's libflint is linked against a Nix glibc that needs
# GLIBC_ABI_GNU2_TLS, which the host's 2.40 does not provide, and it also pulls
# in an NTL that is not present. A flint and MPFR built here for the host sit at
# this prefix instead, and they take precedence over the store paths above: the
# headers come from here, and `-lflint` resolves here. It needs at most
# GLIBC_2.16 and finds the host's own libmpfr and libgmp.
oracle_host=/tmp/oracle-host
export ZMATH_ORACLE_HOST_PREFIX="$oracle_host"
export C_INCLUDE_PATH="$oracle_host/include${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"
export LIBRARY_PATH="$oracle_host/lib64${LIBRARY_PATH:+:$LIBRARY_PATH}"

# devenv scripts are store derivations, so scripts.gate.exec materialises as
# /nix/store/...-gate/bin/gate, which this host cannot see. Emit the same
# contract into a gitignored directory instead.
#
# KEEP IN SYNC WITH scripts.gate.exec IN devenv.nix. That one is the authority
# for where a real store exists; this one is what actually runs here. When the
# gate gained a `zig build published-tools` step, leaving this shim at bare
# `zig-gate` would have kept the blind spot alive on this host while devenv.nix
# claimed it was closed -- a gate that passes and does not check the thing it
# was added to check. The harness gate also sets GATE_EXCLUDE so gitignored
# benchmark artifacts are not linted as source.
gate_bin="$PWD/.devenv/host-bin"
mkdir -p "$gate_bin"
printf '#!/bin/sh\nzig build published-tools -Dtarget=x86_64-linux-gnu.2.38 -Dcpu=haswell -Doptimize=safe &&\n  GATE_EXCLUDE="./bench/results/ ./.devenv/ ./graphify-out/" exec zig-gate "$@"\n' > "$gate_bin/gate.tmp"
chmod +x "$gate_bin/gate.tmp"
mv -f "$gate_bin/gate.tmp" "$gate_bin/gate"
export PATH="$gate_bin:$PATH"
