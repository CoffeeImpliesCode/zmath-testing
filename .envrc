export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"
use devenv

if [[ -n ${ZMATH_ORACLE_HOST_PREFIX:-} ]]; then
    export C_INCLUDE_PATH="$ZMATH_ORACLE_HOST_PREFIX/include${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"
    export LIBRARY_PATH="$ZMATH_ORACLE_HOST_PREFIX/lib64${LIBRARY_PATH:+:$LIBRARY_PATH}"
fi
