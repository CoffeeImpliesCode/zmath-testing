# No trailing slash: on a host whose global zig cache is on local disk, both of
# these are symlinks into a local directory rather than real directories, and a
# trailing slash would not match a symlink.
.zig-cache
zig-out
.devenv/
.direnv/
test/corpus/generated/records/
test/corpus/generated/probes/
test/corpus/generated/.incomplete
test/corpus/generated/*.tmp
test/corpus/generated/replay.txt
test/corpus/generated/benchmark.txt

# A `--shard` run leaves one record tree per shard under the output root. They
# are working state for a merge, not publication, and a campaign produces
# gigabytes of them.
test/corpus/shards/
test/corpus/ranges/
test/corpus/range-shards/

bench/results/
.ruff_cache/
__pycache__/
.zig-global-cache/
graphify-out/
codedb.snapshot
zig-pkg/
*.o
*.pyc
result*
